# Dev-only override for whichever OCR provider is active (src-tauri/src/config.rs).
# The built .dmg has no .env — it uses the in-app provider/key setup instead,
# stored in config.json under the app's Application Support folder.
#
# Set only the one matching your active provider; leave the other blank.
GEMINI_API_KEY=
# https://aistudio.google.com/apikey — has a free tier

ANTHROPIC_API_KEY=
# https://console.anthropic.com/settings/keys — no ongoing free tier
