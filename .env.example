# Dev-only overrides for whichever OCR provider is active (src-tauri/src/config.rs).
# The built .dmg has no .env — it uses the in-app provider/key setup instead,
# stored in config.json under the app's Application Support folder.
#
# Set only the one matching your active provider; leave the rest blank.

# https://aistudio.google.com/apikey — free tier
GEMINI_API_KEY=

# https://simpletex.cn/user/center — purpose-built formula OCR, 2000 calls/day free
SIMPLETEX_API_KEY=

# https://openrouter.ai/keys — routes to free vision models, 50 req/day free
OPENROUTER_API_KEY=

# https://platform.openai.com/api-keys — no free tier, cents/month at this volume
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys — no ongoing free tier
ANTHROPIC_API_KEY=
