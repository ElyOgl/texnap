{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "texnap",
  "version": "0.7.0",
  "identifier": "fr.elyo.texnap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "texnap",
        "width": 500,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "dragDropEnabled": true,
        "backgroundColor": "#121214"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQUI1M0QwRTEzRDZCNgpSV1MyMWhNT1BiV3FDUnJjb0E4azR3ZVp0V1ZlTllWNUV0Q3h0UXkyVU1tMEtqWS9vOVQ2TjVIZQo=",
      "endpoints": [
        "https://github.com/ElyOgl/texnap/releases/latest/download/latest.json"
      ]
    }
  }
}
