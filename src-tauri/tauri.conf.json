{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "texnap",
  "version": "0.2.0",
  "identifier": "fr.elyo.texnap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "texnap",
        "width": 500,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "dragDropEnabled": true,
        "backgroundColor": "#121214"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
